// Prisma schema – Nini Cakes (MySQL 8)
// Khóa thiết kế: tiền VND lưu Int, cộng gộp pray default; bảng map snake_case cho raw SQL report.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethodType {
  COD
  BANK_TRANSFER
}

enum PaymentStatusType {
  UNPAID
  PAID
  REFUNDED
}

enum CouponType {
  PERCENT
  AMOUNT
}

enum PostType {
  STORY
  POLICY
  FAQ
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())

  users User[]
  @@map("roles")
}

/// Khách hàng đăng nhập bằng số điện thoại, email chỉ còn bắt buộc với tài khoản quản trị.
model User {
  id           Int        @id @default(autoincrement())
  email        String?    @unique @db.VarChar(190)
  passwordHash String     @db.VarChar(255)
  fullName     String     @db.VarChar(190)
  phone        String?    @unique @db.VarChar(30)
  avatarUrl    String?    @db.VarChar(500)
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  posts         Post[]
  refreshTokens RefreshToken[]
  statusHistory OrderStatusHistory[] @relation("StatusHistoryActor")

  @@index([roleId])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String    @db.VarChar(190)
  phone       String    @db.VarChar(30)
  addressLine String    @db.VarChar(255)
  ward        String?   @db.VarChar(100)
  district    String?   @db.VarChar(100)
  city        String    @db.VarChar(100)
  lat         Float?
  lng         Float?
  mapsUrl     String?   @db.VarChar(500)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(190)
  slug        String     @unique @db.VarChar(190)
  description String?    @db.Text
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@map("categories")
}

model Allergen {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(60)
  icon      String?   @db.VarChar(10)
  deletedAt DateTime?

  ingredients IngredientAllergen[]
  products    ProductAllergen[]
  @@map("allergens")
}

model Ingredient {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(120)
  note      String?   @db.VarChar(255)
  deletedAt DateTime?

  allergens IngredientAllergen[]
  products  ProductIngredient[]
  @@map("ingredients")
}

model IngredientAllergen {
  ingredientId Int
  allergenId   Int

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergen   Allergen   @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([ingredientId, allergenId])
  @@index([allergenId])
  @@map("ingredient_allergens")
}

model Product {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(190)
  slug             String    @unique @db.VarChar(190)
  shortDescription String?   @db.VarChar(255)
  description      String?   @db.Text
  categoryId       Int
  category         Category  @relation(fields: [categoryId], references: [id])
  price            Int       @default(0)
  compareAtPrice   Int?
  isActive         Boolean   @default(true)
  isFeatured       Boolean   @default(false)
  isSeasonal       Boolean   @default(false)
  ratingAvg        Float     @default(0)
  ratingCount      Int       @default(0)
  soldCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  images     ProductImage[]
  variants   ProductVariant[]
  ingredients ProductIngredient[]
  allergens  ProductAllergen[]
  reviews    Review[]
  orderItems OrderItem[]
  wishlists  Wishlist[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isSeasonal])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String?  @db.VarChar(500)
  alt       String?  @db.VarChar(255)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(120)
  flavor    String?  @db.VarChar(80)
  price     Int
  stock     Int      @default(0)
  sku       String?  @unique @db.VarChar(60)
  isActive  Boolean  @default(true)
  soldCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductIngredient {
  productId    Int
  ingredientId Int
  quantity     String? @db.VarChar(60)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model ProductAllergen {
  productId  Int
  allergenId Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([productId, allergenId])
  @@index([allergenId])
  @@map("product_allergens")
}

model Cart {
  id        Int       @id @default(autoincrement())
  token     String?   @unique @db.VarChar(64)
  userId    Int?      @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items CartItem[]
  @@map("carts")
}

model CartItem {
  id        Int       @id @default(autoincrement())
  cartId    Int
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int       @default(1)
  unitPrice Int
  options   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              Int               @id @default(autoincrement())
  code            String            @unique @db.VarChar(30)
  userId          Int?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          OrderStatus       @default(PENDING)
  deliveryType    DeliveryType
  deliveryDate    DateTime
  timeSlot        String            @db.VarChar(20)
  recipientName   String            @db.VarChar(190)
  recipientPhone  String            @db.VarChar(30)
  addressLine     String?           @db.VarChar(255)
  ward            String?           @db.VarChar(100)
  district        String?           @db.VarChar(100)
  city            String?           @db.VarChar(100)
  lat             Float?
  lng             Float?
  mapsUrl         String?           @db.VarChar(500)
  note            String?           @db.Text
  subtotal        Int
  discount        Int               @default(0)
  shippingFee     Int               @default(0)
  total           Int
  couponId        Int?
  coupon          Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode      String?           @db.VarChar(50)
  paymentMethod   PaymentMethodType
  paymentStatus   PaymentStatusType @default(UNPAID)
  cancelReason    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  items    OrderItem[]
  history  OrderStatusHistory[]
  payments Payment[]

  @@index([status])
  @@index([userId])
  @@index([deliveryDate])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name        String          @db.VarChar(190)
  variantName String?         @db.VarChar(190)
  imageUrl    String?         @db.VarChar(500)
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  options     Json?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  String?  @db.VarChar(30)
  toStatus    String   @db.VarChar(30)
  note        String?  @db.Text
  changedById Int?
  changedBy   User?    @relation("StatusHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("order_status_histories")
}

model Payment {
  id        Int               @id @default(autoincrement())
  orderId   Int
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethodType
  status    PaymentStatusType @default(UNPAID)
  amount    Int
  reference String?           @db.VarChar(255)
  /// Bội thu nhà cung cấp: { provider, paymentLinkId, bin, accountNumber, accountName, qrCode, checkoutUrl }
  providerMeta Json?
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([orderId])
  @@map("payments")
}

model Coupon {
  id          Int        @id @default(autoincrement())
  code        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  type        CouponType
  value       Int
  minSubtotal Int        @default(0)
  maxDiscount Int?
  maxUses     Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  orders Order[]
  @@map("coupons")
}

model Review {
  id        Int       @id @default(autoincrement())
  productId Int
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int?
  rating    Int
  comment   String?   @db.Text
  imageUrl  String?   @db.VarChar(500)
  reply     String?   @db.Text
  repliedAt DateTime?
  isApproved Boolean  @default(false)
  isHidden  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([productId, userId])
  @@index([productId])
  @@index([isApproved])
  @@map("reviews")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(190)
  subtitle  String?  @db.VarChar(255)
  imageUrl  String?  @db.VarChar(500)
  linkUrl   String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Post {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  slug         String    @unique @db.VarChar(255)
  excerpt      String?   @db.Text
  content      String    @db.Text
  coverImageUrl String?  @db.VarChar(500)
  authorId     Int?
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type         PostType  @default(STORY)
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished])
  @@map("posts")
}

model StoreSetting {
  id                Int      @id @default(autoincrement())
  name              String   @default("Nini Cakes") @db.VarChar(190)
  slogan            String?  @db.VarChar(255)
  address           String   @default("") @db.VarChar(255)
  phone             String   @default("") @db.VarChar(30)
  email             String   @default("") @db.VarChar(190)
  openingHours      String   @default("") @db.VarChar(190)
  facebook          String?  @db.VarChar(255)
  instagram         String?  @db.VarChar(255)
  zalo              String?  @db.VarChar(255)
  bankName          String   @default("") @db.VarChar(190)
  bankAccountName   String   @default("") @db.VarChar(190)
  bankAccountNumber String   @default("") @db.VarChar(50)
  shippingFeeVnd    Int      @default(30000)
  freeShippingMinVnd Int     @default(1500000)
  updatedAt         DateTime @updatedAt

  @@map("store_settings")
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(190)
  email     String   @db.VarChar(190)
  phone     String?  @db.VarChar(30)
  subject   String?  @db.VarChar(255)
  content   String   @db.Text
  imageUrl  String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}

model Subscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(190)
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@map("subscribers")
}
