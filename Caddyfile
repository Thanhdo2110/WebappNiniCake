# ============ Caddy: HTTPS tu dong (Let's Encrypt) ============
# DOI 3 TEN MIEN duoi day thanh ten mien that cua tiem truoc khi chay.
# Caddy tu xin va tu gia han chung chi, khong can certbot.
# DIEU KIEN: DNS da tro ve IP VPS thi moi xin duoc cert.

ninicakes.vn {
	reverse_proxy customer-web:80
}

www.ninicakes.vn {
	redir https://ninicakes.vn{uri} permanent
}

# Trang quan tri. Can che them basic_auth o duoi de khong ai do duoc mat khau admin.
quantri.ninicakes.vn {
	reverse_proxy admin-web:80

	# Them 2 dong nay (bo dau #), tao hash bang lenh o cuoi file:
	# basic_auth {
	# 	admin $2a$14$...hash...
	# }
}

# Tao hash mat khau:  docker compose exec caddy caddy hash-password
