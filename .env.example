# ================= Nini Cakes - Environment =================
# Copy file này thành .env trước khi `docker compose up`

NODE_ENV=development
PORT=4000

# --- Database (MySQL 8 chạy qua docker compose ở port 3308) ---
MYSQL_ROOT_PASSWORD=root_secret_2024
MYSQL_PASSWORD=nini_secret_2024

# Local dev (Prisma / seed chạy từ máy host):
DATABASE_URL=mysql://nini:nini_secret_2024@localhost:3308/ninicakes

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS: client được phép gọi API ---
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081

# --- Upload ảnh ---
UPLOAD_DRIVER=local            # local | cloudinary
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
CLOUDINARY_URL=                # ví dụ cloudinary://api_key:api_secret@cloud_name

# --- Email (tùy chọn) cho quên mật khẩu / xác nhận đơn ---
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Nini Cakes <no-reply@ninicakes.vn>"

# --- Seed ---
SEED_SAMPLE_DATA=true
ADMIN_EMAIL=admin@ninicakes.vn
ADMIN_PASSWORD=Admin@123
